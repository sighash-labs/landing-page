---
import '../styles/global.css';
import logo from '../../public/logo/logo_sighas_labs_colorful_trim.png';

const {
  title = 'Sighash Labs',
  description = 'Sighash Labs delivers UTXO smart contract development, protocol consulting, and security audits for Bitcoin, Bitcoin Cash, OPCAT layer, and Bitcoin-like systems.',
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Index' },
  { href: '/audits', label: 'Audits' },
];

const currentPath = Astro.url.pathname?.replace(/\/$/, '') || '/';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen flex-col">
      <header class="sticky top-0 z-40 border-b border-line bg-paper/80 backdrop-blur">
        <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-5 sm:gap-6">
          <a href="/" class="shrink-0">
            <img src={logo.src} alt="Sighash Labs" class="h-5 w-auto sm:h-6" />
          </a>
          <div class="flex shrink-0 items-center gap-4 font-mono text-xs tracking-wide sm:gap-6">
            {navLinks.map(({ href, label }) => {
              const normalized = href === '/' ? '/' : href.replace(/\/$/, '');
              const isActive = currentPath === normalized;
              return (
                <a
                  href={href}
                  class={`transition-colors ${isActive ? 'text-ink' : 'text-stone-500 hover:text-ink'}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {label}
                </a>
              );
            })}
            <a href="mailto:info@sighash.xyz" class="text-emerald-700 transition-colors hover:text-ink">
              Contact
            </a>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-line">
        <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-8 font-mono text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} Sighash Labs</p>
          <div class="flex items-center gap-6">
            <a href="https://x.com/SighashLabs" rel="noopener noreferrer" class="transition-colors hover:text-ink">X</a>
            <a href="mailto:info@sighash.xyz" class="transition-colors hover:text-ink">info@sighash.xyz</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
