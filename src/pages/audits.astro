---
import BaseLayout from '../layouts/BaseLayout.astro';

const audits = [
  {
    name: 'ParyonUSD',
    description: 'Stablecoin protocol on Bitcoin Cash.',
    network: 'Bitcoin Cash',
    status: 'Completed',
    report: '/audits/paryonusd.pdf',
  },
];
---

<BaseLayout
  title="Audits – Sighash Labs"
  description="Completed UTXO smart contract and protocol security audits from Sighash Labs."
>
  <section class="mx-auto max-w-5xl px-6 pt-28 pb-16 sm:pt-36">
    <p class="label">Audit archive</p>
    <h1 class="mt-8 max-w-2xl text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl">
      Published security reviews
    </h1>
    <p class="mt-8 max-w-xl text-base leading-relaxed text-stone-600">
      Public reports for UTXO smart contracts and transaction protocols, where clients have approved publication.
    </p>
  </section>

  <section class="rule">
    <div class="mx-auto max-w-5xl px-6">
      {audits.map((audit) => (
        <article class="grid gap-6 border-line py-10 sm:grid-cols-[1.5fr_1fr_1fr_auto] sm:items-baseline [&:not(:first-child)]:border-t">
          <div>
            <h2 class="text-lg font-medium">{audit.name}</h2>
            <p class="mt-2 text-sm text-stone-600">{audit.description}</p>
          </div>
          <div>
            <p class="label">Network</p>
            <p class="mt-2 text-sm text-stone-700">{audit.network}</p>
          </div>
          <div>
            <p class="label">Status</p>
            <p class="mt-2 text-sm text-stone-700">{audit.status}</p>
          </div>
          {audit.report && (
            <a href={audit.report} class="font-mono text-sm text-emerald-700 transition-colors hover:text-ink">
              Report →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="rule">
    <div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-20 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="max-w-md text-2xl font-medium leading-snug tracking-tight sm:text-3xl">
        Request an audit or pre-launch review.
      </h2>
      <a href="mailto:info@sighash.xyz" class="font-mono text-sm text-emerald-700 transition-colors hover:text-ink">
        info@sighash.xyz →
      </a>
    </div>
  </section>
</BaseLayout>
