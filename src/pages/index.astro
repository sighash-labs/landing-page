---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    title: 'Development',
    copy: 'Covenant-driven contracts, transaction builders, and wallet flows, built with your team.',
  },
  {
    title: 'Consulting',
    copy: 'Protocol and transaction-model design for Bitcoin and adjacent chains.',
  },
  {
    title: 'Audits',
    copy: 'Manual review of scripts, covenants, and signing paths before funds are at risk.',
  },
];

---

<BaseLayout
  title="Sighash Labs | UTXO Programmability"
  description="UTXO smart contract development, consulting, and security audits for Bitcoin, Bitcoin Cash, OPCAT layer, Liquid, Arkade, and Fractal."
>
  <section class="relative isolate overflow-hidden">
    <div class="plate" aria-hidden="true">
      <div class="plate-frame">
        <img src="/bg/owl-plate.jpg" alt="" fetchpriority="high" />
      </div>
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-28 pb-24 sm:pt-40 sm:pb-32">
      <h1 class="mt-8 text-4xl font-medium leading-[1.1] tracking-tight sm:text-6xl">
        UTXO programmability<br />for
        <span class="text-rotator" aria-live="polite">
          <span class="text-rotator-line">Bitcoin</span>
          <span class="text-rotator-line">Bitcoin Cash</span>
          <span class="text-rotator-line">Liquid</span>
          <span class="text-rotator-line">Arkade</span>
          <span class="text-rotator-line">Fractal</span>
        </span>
      </h1>
      <p class="mt-8 max-w-md text-base leading-relaxed text-stone-600">
        We design, build, and audit smart contracts and transaction protocols for Bitcoin-like systems.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-4 font-mono text-xs">
        <a
          href="mailto:info@sighash.xyz"
          class="border border-ink bg-ink px-6 py-3 text-paper transition-colors hover:bg-transparent hover:text-ink"
        >
          Start a project
        </a>
        <a
          href="/audits"
          class="border border-line px-6 py-3 text-stone-600 transition-colors hover:border-ink/40 hover:text-ink"
        >
          Audit archive
        </a>
      </div>
    </div>
  </section>

  <section class="rule">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid sm:grid-cols-3">
        {services.map((service, index) => (
          <div class="border-line py-10 sm:px-8 sm:py-14 sm:first:pl-0 sm:last:pr-0 sm:[&:not(:first-child)]:border-l [&:not(:first-child)]:border-t sm:[&:not(:first-child)]:border-t-0">
            <p class="label">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mt-5 text-lg font-medium">{service.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-stone-600">{service.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rule">
    <div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-20 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="max-w-md text-2xl font-medium leading-snug tracking-tight sm:text-3xl">
        Bring us in before the transaction model hardens.
      </h2>
      <a href="mailto:info@sighash.xyz" class="font-mono text-sm text-emerald-700 transition-colors hover:text-ink">
        info@sighash.xyz →
      </a>
    </div>
  </section>
</BaseLayout>
